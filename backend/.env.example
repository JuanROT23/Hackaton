# Copia este archivo como .env si necesitas cambiar algo. El .env NO se versiona.

# Base SQLite. Si se omite: backend/cosco_shipping.db
DATABASE_URL=

# Excel sintético de origen. Si se omite: el archivo de la raíz del proyecto
EXCEL_PATH=

# Único origen del frontend autorizado por CORS (nunca "*")
FRONTEND_ORIGIN=http://localhost:5173
