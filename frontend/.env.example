# Copia como .env si necesitas cambiar algo. El .env no se versiona.

# URL del backend al que el servidor de desarrollo reenvía /api (proxy de Vite)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Solo para el build de producción, si el backend está en otro dominio.
# Vacío = mismas rutas relativas (/api/v1/...)
VITE_API_URL=
