# Copia como .env si necesitas cambiar algo. El .env no se versiona.

# URL del backend. Si se omite: http://localhost:8000
# En Netlify se define en Site configuration > Environment variables (sin "/" al final).
VITE_API_URL=

# Solo desarrollo: backend al que el servidor de Vite reenvía /api (proxy)
VITE_BACKEND_URL=http://127.0.0.1:8000
